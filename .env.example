# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_...). Older projects can set
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Exchange-rate provider. No key needed for open.er-api.com.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/QAR

# Never put the service-role key in a NEXT_PUBLIC_ variable.
